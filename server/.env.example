# Copy to server/.env and fill in. On Render, set the same names as the
# service's environment variables. Never commit the real values.

# Port to listen on (Render sets it itself). Default 5050.
PORT=

# "production" on Render: the localhost origins are then not allowed.
NODE_ENV=

# MongoDB connection string (mongodb+srv://...). Required.
MONGODB_URI=

# Shared secret the website and extension send in the x-client-secret
# header (their VITE_CLIENT_SECRET). Required: the server won't start without it.
CLIENT_SECRET=

# Extra browser origins allowed to call the API, comma-separated: the
# website and the extension (chrome-extension://<id>). The localhost dev
# origins are added automatically unless NODE_ENV is "production".
ALLOWED_ORIGINS=

# Google Drive: an OAuth2 client and a refresh token with the Drive scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Drive folders for uploads: thumbnails, STL files, Parasolid files.
GOOGLE_DRIVE_IMAGE_FOLDER_ID=
GOOGLE_DRIVE_STL_FOLDER_ID=
GOOGLE_DRIVE_PARASOLID_FOLDER_ID=
