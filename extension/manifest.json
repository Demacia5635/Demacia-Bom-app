{
  "manifest_version": 3,
  "name": "Demacia BOM for Onshape",
  "version": "0.0.0",
  "description": "Demacia BOM side panel for Onshape assemblies.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "cookies"],
  "host_permissions": ["https://*.onshape.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Demacia BOM" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    {
      "matches": ["https://*.onshape.com/documents/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.svg"],
      "matches": ["https://*.onshape.com/*"]
    }
  ]
}
